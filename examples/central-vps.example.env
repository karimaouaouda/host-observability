# Identity
HOST_ID=observability-central
ENVIRONMENT=production
REGION=
DATACENTER=

# Direct loopback access on the VPS hosting the central stack.
# Confirm these ports and paths against that stack's actual listeners.
GRAFANA_URL=http://127.0.0.1:3000
PROMETHEUS_WRITE_URL=http://127.0.0.1:9090/api/v1/write
LOKI_WRITE_URL=http://127.0.0.1:3100/loki/api/v1/push
OBSERVABILITY_AUTH_ENABLED=false
OBSERVABILITY_USERNAME=
OBSERVABILITY_PASSWORD=
TLS_INSECURE_SKIP_VERIFY=false

ENABLE_HOST_METRICS=true
ENABLE_DOCKER_METRICS=true
ENABLE_DOCKER_LOGS=true
DOCKER_HOST=unix:///var/run/docker.sock
ENABLE_NGINX_LOGS=true
NGINX_ACCESS_LOG=/var/log/nginx/access.log
NGINX_ERROR_LOG=/var/log/nginx/error.log
# Avoid instrumenting Grafana/Prometheus/Loki themselves by default on this host.
ENABLE_BEYLA=false
BEYLA_CONTAINERS_ONLY=true
BEYLA_OPEN_PORTS=3000,8000-8999
ALLOY_HTTP_ADDRESS=127.0.0.1:12345
