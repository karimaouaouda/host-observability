  forward_to = [loki.write.central.receiver]
}
loki.write "central" {
  endpoint {
    url = sys.env("LOKI_WRITE_URL")
    // AUTH_BEGIN
    basic_auth {
      username = sys.env("OBSERVABILITY_USERNAME")
      password = sys.env("OBSERVABILITY_PASSWORD")
    }
    // AUTH_END
    tls_config { insecure_skip_verify = @TLS_INSECURE_SKIP_VERIFY@ }
