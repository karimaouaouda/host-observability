// Generated by per-host-observe. Source: ENABLE_NGINX_LOGS.
local.file_match "nginx" {
  path_targets = [
    { __path__ = "@ACCESS_LOG@", source = "nginx", log_type = "access" },
    { __path__ = "@ERROR_LOG@", source = "nginx", log_type = "error" },
  ]
}
loki.source.file "nginx" {
  targets = local.file_match.nginx.targets
  forward_to = [loki.process.identity.receiver]
}
